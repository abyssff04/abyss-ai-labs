# ─── Abyss AI Labs — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Change to your production URL when deploying, e.g.:
# NEXT_PUBLIC_SITE_URL=https://abyssailabs.com

# ─── Email Service (choose one, uncomment and fill in) ────────────────────────

# Option A: Resend (recommended — https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@abyssailabs.com
# CONTACT_TO_EMAIL=hello@abyssailabs.com

# Option B: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=hello@abyssailabs.com

# Option C: SMTP / Nodemailer
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=yourpassword
# CONTACT_TO_EMAIL=hello@abyssailabs.com

# ─── Database (optional — only needed if using schema.sql) ────────────────────
# Supports Supabase, Neon, PlanetScale, or any PostgreSQL-compatible DB.
# DATABASE_URL=postgresql://user:password@host:5432/abyss_ai_labs

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
